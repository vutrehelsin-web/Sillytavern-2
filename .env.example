# GEMINI_API_KEY: Required for built-in Gemini chat model calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this service is hosted.
APP_URL="MY_APP_URL"

# TTS_ENDPOINT_URL: ElevenLabs / OpenAI-compatible /v1/audio/speech endpoint.
TTS_ENDPOINT_URL="https://ais-pre-u7l73h3ecm66d62zwylz6x-227764188141.us-east1.run.app/v1/audio/speech"

# TTS_API_KEY: Optional Bearer / xi-api-key header sent by the server TTS proxy.
TTS_API_KEY=

# CUSTOM_CHAT_BASE_URL: Optional OpenAI-compatible base URL (e.g. https://openrouter.ai/api/v1).
CUSTOM_CHAT_BASE_URL=

# CUSTOM_CHAT_MODEL: Optional default model ID for the arbitrary OpenAI-compatible chat endpoint.
CUSTOM_CHAT_MODEL=

# CUSTOM_CHAT_API_KEY: Optional API key for the arbitrary OpenAI-compatible chat endpoint.
CUSTOM_CHAT_API_KEY=
